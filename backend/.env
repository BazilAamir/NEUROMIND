# MongoDB Connection String
# Replace with your MongoDB Atlas connection string or local MongoDB URI
MONGODB_URI=mongodb://localhost:27017/neuromind

# For MongoDB Atlas, use:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/neuromind?retryWrites=true&w=majority

# JWT Secret Key (change this to a random secure string)
JWT_SECRET=your_super_secret_jwt_key_change_this

# Server Port
PORT=5000
